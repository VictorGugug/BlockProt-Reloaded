package de.sean.blockprot.bukkit.groups;

import de.sean.blockprot.bukkit.BlockProt;
import de.sean.blockprot.bukkit.nbt.BlockNBTHandler;
import de.sean.blockprot.bukkit.nbt.FriendHandler;
import de.sean.blockprot.bukkit.storage.HybridDatabase;
import org.bukkit.Bukkit;
import org.bukkit.Location;
import org.bukkit.block.Block;
import org.jetbrains.annotations.NotNull;
import org.jetbrains.annotations.Nullable;

import java.util.*;
import java.util.concurrent.ConcurrentHashMap;

/**
 * In-memory registry for block lock groups.
 *
 * <p>A group is identified by a short random string (group ID) stored in each
 * member block's NBT as {@code blockprot_group_id}.  When the friend list on
 * any member is mutated, {@link #syncFriends} propagates the change to every
 * other member in the same group so they always share an identical friend list.
 *
 * <p>The registry is populated at server startup by
 * {@link de.sean.blockprot.bukkit.BlockProt#onEnable()} and cleared on disable.
 * It is purely in-memory; the authoritative data lives in the block NBT.
 */
public final class LockGroupRegistry {

    /** group_id → set of block locations in the group. */
    private static final Map<String, Set<Location>> groups = new ConcurrentHashMap<>();

    /** location → group_id (reverse index for O(1) lookup). */
    private static final Map<Location, String> locationToGroup = new ConcurrentHashMap<>();

    // ── Per-group metadata (loaded from SQL, kept in memory) ─────────────────

    /** Immutable snapshot of group metadata. */
    public record GroupMeta(
        @NotNull String groupId,
        @NotNull String ownerUuid,
        @NotNull String displayName,
        long createdAt
    ) {}

    /** group_id → metadata */
    private static final Map<String, GroupMeta> groupMeta = new ConcurrentHashMap<>();

    // ── Join-request queue (in-memory, backed by SQL) ─────────────────────────

    /**
     * Immutable join-request record.
     *
     * @param groupId       target group
     * @param requesterUuid UUID string of the requesting player
     * @param block         the block the requester wants to add
     */
    public record JoinRequest(
        @NotNull String groupId,
        @NotNull String requesterUuid,
        @NotNull org.bukkit.block.Block block
    ) {}

    /**
     * group_id → list of pending join requests.
     * A player may have at most one pending request per group (enforced on insert).
     */
    private static final Map<String, List<JoinRequest>> joinRequests = new ConcurrentHashMap<>();

    private LockGroupRegistry() {}

    // ─────────────────────────────────────────────────────────────────────────
    // Startup registration
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Register a block as part of a group without syncing friends.
     * Used during server startup when loading existing block data; the friend
     * lists are already written to NBT so no propagation is needed.
     *
     * @param block   the block to register
     * @param groupId the group ID stored in the block's NBT
     */
    public static void registerBlock(@NotNull Block block, @NotNull String groupId) {
        if (!isEnabled() || groupId.isEmpty()) return;
        Location loc = block.getLocation();
        groups.computeIfAbsent(groupId, k -> ConcurrentHashMap.newKeySet()).add(loc);
        locationToGroup.put(loc, groupId);
    }

    /**
     * Loads group metadata from SQL into memory.  Called once at startup
     * after {@link #registerBlock} passes are complete.
     */
    public static void loadMetadataFromDatabase() {
        HybridDatabase db = BlockProt.getHybridDatabase();
        if (db == null || !db.isEnabled()) return;
        for (HybridDatabase.GroupRow row : db.loadAllGroups()) {
            groupMeta.put(row.groupId(), new GroupMeta(
                row.groupId(), row.ownerUuid(), row.displayName(), row.createdAt()));
        }
        // Restore pending join requests — block references require loaded chunks;
        // requests for unloaded blocks are silently skipped and will be re-sent
        // by players when they next open the GUI.
        for (HybridDatabase.JoinRequestRow row : db.loadAllJoinRequests()) {
            org.bukkit.World world = Bukkit.getWorld(row.world());
            if (world == null) continue;
            try {
                org.bukkit.block.Block b = world.getBlockAt(row.x(), row.y(), row.z());
                addJoinRequest(row.groupId(), row.requesterUuid(), b, false);
            } catch (RuntimeException ignored) {}
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Runtime group management
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Add a block to a group at runtime (e.g. from GroupManageInventory).
     * Syncs the current group friend list to the newly added block.
     *
     * @param block   the block to add
     * @param groupId the target group ID
     * @return {@code true} if the block was added, {@code false} if the group
     *         is full or the feature is disabled
     */
    public static boolean addBlockToGroup(@NotNull Block block, @NotNull String groupId) {
        if (!isEnabled() || groupId.isEmpty()) return false;

        int maxSize = BlockProt.getDefaultConfig().getLockGroupMaxSize();
        Set<Location> groupBlocks = groups.computeIfAbsent(groupId, k -> ConcurrentHashMap.newKeySet());

        if (maxSize > 0 && groupBlocks.size() >= maxSize) return false; // group is full

        Location loc = block.getLocation();
        groupBlocks.add(loc);
        locationToGroup.put(loc, groupId);

        // Sync the existing friend list to the newly added block.
        // We read friends from the first other member we can find.
        try {
            List<FriendHandler> existingFriends = getFriendListFromGroup(groupId, loc);
            if (!existingFriends.isEmpty()) {
                try {
                    BlockNBTHandler.suppressGroupSync.set(true);
                    BlockNBTHandler handler = new BlockNBTHandler(block);
                    handler.setFriends(existingFriends);
                } finally {
                    BlockNBTHandler.suppressGroupSync.remove();
                }
            }
        } catch (RuntimeException ignored) {}

        return true;
    }

    /**
     * Creates a brand-new group, registering metadata in SQL.
     *
     * @param block       the first block of the new group
     * @param groupId     the generated group ID
     * @param ownerUuid   UUID string of the creating player
     * @param displayName initial display name (may be empty)
     */
    public static boolean createGroup(@NotNull Block block, @NotNull String groupId,
                                      @NotNull String ownerUuid, @NotNull String displayName) {
        if (!isEnabled() || groupId.isEmpty()) return false;

        long now = System.currentTimeMillis();
        GroupMeta meta = new GroupMeta(groupId, ownerUuid, displayName, now);
        groupMeta.put(groupId, meta);

        HybridDatabase db = BlockProt.getHybridDatabase();
        if (db != null && db.isEnabled()) {
            db.upsertGroup(groupId, ownerUuid, displayName, now);
        }

        return addBlockToGroup(block, groupId);
    }

    /**
     * Renames a group.  Updates in-memory metadata and persists to SQL.
     *
     * @param groupId     the group to rename
     * @param displayName new display name
     */
    public static void renameGroup(@NotNull String groupId, @NotNull String displayName) {
        GroupMeta old = groupMeta.get(groupId);
        if (old == null) return;
        GroupMeta updated = new GroupMeta(groupId, old.ownerUuid(), displayName, old.createdAt());
        groupMeta.put(groupId, updated);

        HybridDatabase db = BlockProt.getHybridDatabase();
        if (db != null && db.isEnabled()) {
            db.upsertGroup(groupId, old.ownerUuid(), displayName, old.createdAt());
        }
    }

    // ── Join-request management ──────────────────────────────────────────

    /**
     * Submits a join request.  Replaces any existing pending request from the
     * same player in the same group.
     *
     * @param groupId       target group ID
     * @param requesterUuid UUID string of the requesting player
     * @param block         the block the requester wants to add to the group
     * @param persist       whether to persist to SQL (false during startup restore)
     */
    public static void addJoinRequest(@NotNull String groupId, @NotNull String requesterUuid,
                                      @NotNull org.bukkit.block.Block block, boolean persist) {
        List<JoinRequest> list = joinRequests.computeIfAbsent(groupId,
            k -> java.util.Collections.synchronizedList(new ArrayList<>()));
        // Remove any existing request from this player
        list.removeIf(r -> r.requesterUuid().equals(requesterUuid));
        list.add(new JoinRequest(groupId, requesterUuid, block));

        if (persist) {
            HybridDatabase db = BlockProt.getHybridDatabase();
            if (db != null && db.isEnabled() && block.getWorld() != null) {
                db.upsertJoinRequest(groupId, requesterUuid,
                    block.getWorld().getName(),
                    block.getX(), block.getY(), block.getZ());
            }
        }
    }

    /**
     * Returns an immutable snapshot of pending join requests for a group.
     */
    @NotNull
    public static List<JoinRequest> getJoinRequests(@NotNull String groupId) {
        List<JoinRequest> list = joinRequests.get(groupId);
        return list != null ? new ArrayList<>(list) : List.of();
    }

    /**
     * Returns the number of pending join requests for a group.
     */
    public static int getJoinRequestCount(@NotNull String groupId) {
        List<JoinRequest> list = joinRequests.get(groupId);
        return list != null ? list.size() : 0;
    }

    /**
     * Removes a single join request (accepted or rejected) and deletes it from SQL.
     *
     * @param groupId       the group
     * @param requesterUuid UUID string of the requester
     */
    public static void removeJoinRequest(@NotNull String groupId, @NotNull String requesterUuid) {
        List<JoinRequest> list = joinRequests.get(groupId);
        if (list != null) list.removeIf(r -> r.requesterUuid().equals(requesterUuid));

        HybridDatabase db = BlockProt.getHybridDatabase();
        if (db != null && db.isEnabled()) db.deleteJoinRequest(groupId, requesterUuid);
    }

    /**
     * Returns {@code true} if the given player already has a pending request for the group.
     */
    public static boolean hasPendingRequest(@NotNull String groupId, @NotNull String requesterUuid) {
        List<JoinRequest> list = joinRequests.get(groupId);
        if (list == null) return false;
        return list.stream().anyMatch(r -> r.requesterUuid().equals(requesterUuid));
    }

    /**
     * Remove a single block from its group.  If the group becomes empty, it is
     * deleted from the registry automatically.
     *
     * @param block the block to remove
     */
    public static void removeBlockFromGroup(@NotNull Block block) {
        Location loc = block.getLocation();
        String groupId = locationToGroup.remove(loc);
        if (groupId == null) return;

        Set<Location> groupBlocks = groups.get(groupId);
        if (groupBlocks != null) {
            groupBlocks.remove(loc);
            if (groupBlocks.isEmpty()) groups.remove(groupId);
        }
    }

    /**
     * Dissolve a group entirely:  clears the {@code group_id} NBT tag from
     * every member block and removes the group from the registry.
     *
     * @param groupId the group to dissolve
     */
    public static void dissolveGroup(@NotNull String groupId) {
        Set<Location> groupBlocks = groups.remove(groupId);
        groupMeta.remove(groupId);
        joinRequests.remove(groupId);

        HybridDatabase db = BlockProt.getHybridDatabase();
        if (db != null && db.isEnabled()) {
            db.deleteGroup(groupId);
            db.deleteAllJoinRequests(groupId);
        }

        if (groupBlocks == null) return;
        for (Location loc : groupBlocks) {
            locationToGroup.remove(loc);
            try {
                BlockNBTHandler handler = new BlockNBTHandler(loc.getBlock());
                handler.setGroupId("");
            } catch (RuntimeException ignored) {}
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Friend synchronisation
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Propagate a new friend list to every group member except the block that
     * triggered the change.  Called from
     * {@link BlockNBTHandler#onFriendsMutated()}.
     *
     * <p>Re-entrant safety: {@link BlockNBTHandler#setFriends} calls
     * {@link BlockNBTHandler#onFriendsMutated()} which calls this method.
     * We avoid infinite loops by using the {@link BlockNBTHandler#suppressGroupSync} ThreadLocal.
     *
     * @param groupId    the group whose members to update
     * @param friends    the new canonical friend list (from the triggering block)
     * @param excludeLoc the location of the block that triggered the sync
     */
    public static void syncFriends(@NotNull String groupId,
                                   @NotNull List<FriendHandler> friends,
                                   @NotNull Location excludeLoc) {
        if (!isEnabled() || groupId.isEmpty()) return;

        Set<Location> groupBlocks = groups.get(groupId);
        if (groupBlocks == null || groupBlocks.isEmpty()) return;

        try {
            BlockNBTHandler.suppressGroupSync.set(true);
            for (Location loc : groupBlocks) {
                if (loc.equals(excludeLoc)) continue; // skip the originating block

                try {
                    BlockNBTHandler handler = new BlockNBTHandler(loc.getBlock());
                    handler.setFriends(friends);
                } catch (RuntimeException ignored) {}
            }
        } finally {
            BlockNBTHandler.suppressGroupSync.remove();
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Queries
    // ─────────────────────────────────────────────────────────────────────────

    /**
     * Returns an unmodifiable snapshot of the block locations in a group.
     *
     * @param groupId the group ID
     * @return a set of locations (may be empty if the group doesn't exist)
     */
    @NotNull
    public static Set<Location> getGroupBlocks(@NotNull String groupId) {
        Set<Location> blocks = groups.get(groupId);
        return blocks != null ? new HashSet<>(blocks) : new HashSet<>();
    }

    /**
     * Returns the group ID for a specific block location, or {@code null} if
     * the block is not registered in any group.
     */
    @Nullable
    public static String getGroupForLocation(@NotNull Location loc) {
        return locationToGroup.get(loc);
    }

    /**
     * Returns a snapshot of all currently registered group IDs.
     */
    @NotNull
    public static Set<String> getAllGroups() {
        return new HashSet<>(groups.keySet());
    }

    /**
     * Returns the number of blocks in a group, or 0 if it doesn't exist.
     */
    public static int getGroupSize(@NotNull String groupId) {
        Set<Location> blocks = groups.get(groupId);
        return blocks != null ? blocks.size() : 0;
    }

    /**
     * Returns the metadata for a group, or {@code null} if unknown.
     */
    @Nullable
    public static GroupMeta getGroupMeta(@NotNull String groupId) {
        return groupMeta.get(groupId);
    }

    /**
     * Returns the display name for a group, or the raw group ID if no custom name is set.
     */
    @NotNull
    public static String getDisplayName(@NotNull String groupId) {
        GroupMeta meta = groupMeta.get(groupId);
        if (meta != null && !meta.displayName().isEmpty()) return meta.displayName();
        return groupId;
    }

    /**
     * Returns the owner UUID string of a group, or empty string if unknown.
     */
    @NotNull
    public static String getOwnerUuid(@NotNull String groupId) {
        GroupMeta meta = groupMeta.get(groupId);
        return meta != null ? meta.ownerUuid() : "";
    }

    /**
     * Returns the creation timestamp (epoch-millis) of a group, or 0 if unknown.
     */
    public static long getCreatedAt(@NotNull String groupId) {
        GroupMeta meta = groupMeta.get(groupId);
        return meta != null ? meta.createdAt() : 0L;
    }

    /**
     * Returns the number of distinct players who own at least one block in the group.
     * This is a best-effort O(n) scan over loaded chunks only.
     */
    public static int getUniquePlayerCount(@NotNull String groupId) {
        Set<Location> locs = groups.get(groupId);
        if (locs == null || locs.isEmpty()) return 0;
        Set<String> owners = new HashSet<>();
        for (Location loc : locs) {
            if (!loc.isChunkLoaded()) continue;
            try {
                String owner = new BlockNBTHandler(loc.getBlock()).getOwner();
                if (!owner.isEmpty()) owners.add(owner);
            } catch (RuntimeException ignored) {}
        }
        return owners.size();
    }

    /**
     * Clears all registry state.  Called on plugin disable.
     */
    public static void clear() {
        groups.clear();
        locationToGroup.clear();
        groupMeta.clear();
        joinRequests.clear();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Internals
    // ─────────────────────────────────────────────────────────────────────────

    private static boolean isEnabled() {
        try {
            return BlockProt.getDefaultConfig().isLockGroupsEnabled();
        } catch (AssertionError ignored) {
            return false;
        }
    }

    /**
     * Reads the friend list from the first available member block of the group
     * that is not {@code excludeLoc}.  Returns an empty list if none can be
     * read (e.g. all chunks are unloaded).
     */
    @NotNull
    private static List<FriendHandler> getFriendListFromGroup(@NotNull String groupId,
                                                               @NotNull Location excludeLoc) {
        Set<Location> groupBlocks = groups.get(groupId);
        if (groupBlocks == null) return List.of();

        for (Location loc : groupBlocks) {
            if (loc.equals(excludeLoc)) continue;
            if (!loc.isChunkLoaded()) continue;
            try {
                BlockNBTHandler handler = new BlockNBTHandler(loc.getBlock());
                return handler.getFriends();
            } catch (RuntimeException ignored) {}
        }
        return List.of();
    }
}
